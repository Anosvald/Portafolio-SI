---
// src/components/PanCarga.astro
// Pantalla de carga con temática de ciberseguridad
// Colores y estética del portfolio: purpura, grises oscuros, Onest Variable
---

<div id="pantalla-ransomware" class="pantalla-carga">
    <!-- Fondo decorativo -->
    <div class="background-gradient"></div>
    <div class="background-grid"></div>
    <div class="scan-lines"></div>

    <!-- Header de alerta -->
    <div class="threat-header">
        <div class="threat-indicator">
            <div class="pulse-dot"></div>
            <svg class="threat-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <span class="threat-status">SISTEMA COMPROMETIDO</span>
        </div>
    </div>

    <!-- Contenedor principal -->
    <div class="content-wrapper">
        <div class="left-panel">
            <!-- Panel de terminal -->
            <div class="terminal-section">
                <div class="terminal-header">
                    <div class="terminal-dots">
                        <div class="dot red"></div>
                        <div class="dot yellow"></div>
                        <div class="dot green"></div>
                    </div>
                    <span class="terminal-title">SECURITY_SCAN.EXE</span>
                </div>
                
                <div class="terminal-content">
                    <div class="terminal-line">
                        <span class="prompt">$</span>
                        <span class="command">initialize_protocol</span>
                    </div>
                    <div class="terminal-line">
                        <span class="output">→ Análisis de integridad del sistema</span>
                    </div>
                    <div class="terminal-line">
                        <span class="prompt">$</span>
                        <span class="command">scan_encryption --deep</span>
                    </div>
                    <div class="terminal-line">
                        <span class="output">→ Verificando archivos críticos...</span>
                    </div>
                    <div class="terminal-line">
                        <span class="prompt">$</span>
                        <span class="command blinking">processing...</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="right-panel">
            <!-- Warning box principal -->
            <div class="warning-container">
                <div class="warning-header">
                    <svg class="warning-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3.05h16.94a2 2 0 0 0 1.71-3.05L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                        <line x1="12" y1="9" x2="12" y2="13"></line>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                    </svg>
                </div>
                <h1 class="warning-title">ALERTA CRÍTICA</h1>
                <p class="warning-description">Archivos encriptados con algoritmo <span class="highlight">AES-256-GCM</span></p>
            </div>

            <!-- Barra de progreso -->
            <div class="progress-section">
                <div class="progress-header">
                    <span class="progress-label">VERIFICACIÓN EN CURSO</span>
                    <svg class="lock-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </div>
                
                <div class="progress-bar-container">
                    <div id="progress-bar-fill" class="progress-fill"></div>
                </div>

                <div id="progress-counter" class="progress-percentage">0%</div>
            </div>

            <!-- Stats -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-number">4,782</div>
                    <div class="stat-label">Archivos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">47</div>
                    <div class="stat-label">Críticos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">100%</div>
                    <div class="stat-label">Protección</div>
                </div>
            </div>

            <!-- Instrucciones -->
            <div class="instructions-box">
                <div class="instruction-header">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"></path>
                    </svg>
                    <span>NO REALIZAR ACCIONES</span>
                </div>
                <ul class="instruction-list">
                    <li><span class="x-icon">×</span> Apagar el sistema</li>
                    <li><span class="x-icon">×</span> Cerrar esta ventana</li>
                    <li><span class="x-icon">×</span> Modo seguro</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="footer-section">
        <div class="footer-item">
            <span class="footer-label">SESSION:</span>
            <span>PORTFOLIO-USER-V4.2</span>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-item">
            <span class="footer-label">ENCRYPTION:</span>
            <span>AES-256-GCM</span>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-item">
            <span class="footer-label">THREAT:</span>
            <span class="threat-level">CRÍTICO</span>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        /* Paleta del portfolio */
        --color-primary: #7877c6;
        --color-primary-dark: #6367b8;
        --color-primary-light: #9795d6;
        --color-bg: #030712;
        --color-bg-light: #0f172a;
        --color-text-primary: #f5f5f7;
        --color-text-secondary: #b0b0b8;
        --color-accent: #ff3b5c;
        --color-accent-light: #ff6b82;
        --color-success: #4ade80;
    }

    .pantalla-carga {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: var(--color-bg);
        color: var(--color-primary-light);
        font-family: "Onest Variable", system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        z-index: 99999;
        overflow: hidden;
        user-select: none;
    }

    /* === FONDOS DECORATIVOS === */
    .background-gradient {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 80% 80% at 50% -20%, rgba(120, 119, 198, 0.15), transparent);
        pointer-events: none;
        z-index: 1;
    }

    .background-grid {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(0deg, transparent 24%, rgba(120, 119, 198, 0.04) 25%, rgba(120, 119, 198, 0.04) 26%, transparent 27%, transparent 74%, rgba(120, 119, 198, 0.04) 75%, rgba(120, 119, 198, 0.04) 76%, transparent 77%, transparent),
            linear-gradient(90deg, transparent 24%, rgba(120, 119, 198, 0.04) 25%, rgba(120, 119, 198, 0.04) 26%, transparent 27%, transparent 74%, rgba(120, 119, 198, 0.04) 75%, rgba(120, 119, 198, 0.04) 76%, transparent 77%, transparent);
        background-size: 60px 60px;
        pointer-events: none;
        z-index: 1;
    }

    .scan-lines {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
            0deg,
            rgba(255, 59, 92, 0.015),
            rgba(255, 59, 92, 0.015) 1px,
            transparent 1px,
            transparent 2px
        );
        pointer-events: none;
        animation: flicker 0.15s infinite;
        z-index: 2;
    }

    @keyframes flicker {
        0% { opacity: 0.98; }
        50% { opacity: 0.99; }
        100% { opacity: 0.98; }
    }

    /* === HEADER === */
    .threat-header {
        position: relative;
        padding: 20px;
        border-bottom: 1px solid rgba(120, 119, 198, 0.2);
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(10px);
        z-index: 10;
    }

    .threat-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .pulse-dot {
        width: 12px;
        height: 12px;
        background: var(--color-accent);
        border-radius: 50%;
        animation: threat-pulse 1.5s infinite; 
        box-shadow: 0 0 15px var(--color-accent);
    }

    @keyframes threat-pulse {
        0%, 100% { box-shadow: 0 0 15px var(--color-accent); }
        50% { box-shadow: 0 0 30px var(--color-accent); }
    }

    .threat-icon {
        color: var(--color-accent);
        flex-shrink: 0;
    }

    .threat-status {
        font-size: 13px;
        font-weight: 600;
        color: var(--color-accent);
        text-shadow: 0 0 10px rgba(255, 59, 92, 0.5);
        letter-spacing: 2px;
    }

    /* === CONTENEDOR PRINCIPAL === */
    .content-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        padding: 40px;
        flex: 1;
        position: relative;
        z-index: 10;
        max-width: 1600px;
        margin: 0 auto;
        width: 100%;
    }

    .left-panel {
        display: flex;
        flex-direction: column;
    }

    .right-panel {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* === TERMINAL === */
    .terminal-section {
        background: rgba(3, 30, 66, 0.5);
        border: 1px solid rgba(120, 119, 198, 0.3);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(120, 119, 198, 0.1);
        backdrop-filter: blur(10px);
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .terminal-header {
        background: rgba(15, 23, 42, 0.8);
        padding: 12px 16px;
        border-bottom: 1px solid rgba(120, 119, 198, 0.2);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .dot.red { background: var(--color-accent); }
    .dot.yellow { background: #fbbf24; }
    .dot.green { background: var(--color-success); }

    .terminal-title {
        font-size: 12px;
        color: var(--color-primary-light);
        margin-left: 12px;
        flex: 1;
        font-weight: 500;
    }

    .terminal-content {
        padding: 16px;
        font-size: 12px;
        line-height: 1.8;
        overflow-y: auto;
        flex: 1;
        font-family: 'Monaco', 'Courier New', monospace;
    }

    .terminal-line {
        margin-bottom: 8px;
        display: flex;
        gap: 8px;
    }

    .prompt {
        color: var(--color-primary-light);
        font-weight: 600;
    }

    .command {
        color: var(--color-primary-light);
    }

    .command.blinking::after {
        content: '█';
        animation: blink 1s infinite;
        margin-left: 4px;
        color: var(--color-primary);
    }

    @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    .output {
        color: var(--color-text-secondary);
        opacity: 0.9;
    }

    /* === WARNING CONTAINER === */
    .warning-container {
        background: linear-gradient(135deg, rgba(120, 119, 198, 0.1) 0%, rgba(255, 59, 92, 0.05) 100%);
        border: 1px solid rgba(120, 119, 198, 0.3);
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 20px rgba(120, 119, 198, 0.1);
    }

    .warning-header {
        margin-bottom: 12px;
        display: flex;
        justify-content: center;
    }

    .warning-icon {
        color: var(--color-accent);
        animation: warning-bounce 2s infinite;
    }

    @keyframes warning-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    .warning-title {
        font-size: 22px;
        font-weight: 700;
        color: var(--color-text-primary);
        margin-bottom: 8px;
        letter-spacing: 1px;
    }

    .warning-description {
        font-size: 14px;
        color: var(--color-text-secondary);
        line-height: 1.6;
    }

    .highlight {
        color: var(--color-accent);
        font-weight: 600;
    }

    /* === PROGRESS SECTION === */
    .progress-section {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(120, 119, 198, 0.3);
        border-radius: 12px;
        padding: 20px;
        backdrop-filter: blur(10px);
    }

    .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .progress-label {
        font-size: 11px;
        color: var(--color-primary-light);
        text-transform: uppercase;
        letter-spacing: 1.2px;
        font-weight: 600;
    }

    .lock-icon {
        color: var(--color-accent);
    }

    .progress-bar-container {
        position: relative;
        width: 100%;
        height: 28px;
        background: rgba(3, 30, 66, 0.8);
        border: 1px solid rgba(120, 119, 198, 0.3);
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    #progress-bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
        transition: width 0.1s linear;
        position: relative;
        box-shadow: 0 0 15px rgba(120, 119, 198, 0.6);
    }

    #progress-bar-fill::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        right: 0;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        animation: shimmer 2s infinite;
    }

    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    #progress-counter {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: var(--color-primary);
        text-shadow: 0 0 15px rgba(120, 119, 198, 0.5);
        letter-spacing: 1px;
    }

    /* === STATS GRID === */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .stat-card {
        background: rgba(3, 30, 66, 0.6);
        border: 1px solid rgba(120, 119, 198, 0.3);
        border-radius: 10px;
        padding: 16px;
        text-align: center;
        backdrop-filter: blur(10px);
    }

    .stat-number {
        font-size: 18px;
        font-weight: 700;
        color: var(--color-primary-light);
        margin-bottom: 6px;
    }

    .stat-label {
        font-size: 11px;
        color: var(--color-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* === INSTRUCTIONS === */
    .instructions-box {
        background: linear-gradient(135deg, rgba(255, 59, 92, 0.08) 0%, rgba(120, 119, 198, 0.05) 100%);
        border: 1px dashed rgba(255, 59, 92, 0.3);
        border-radius: 10px;
        padding: 14px;
    }

    .instruction-header {
        font-size: 10px;
        color: var(--color-accent);
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 10px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .instruction-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        list-style: none;
    }

    .instruction-list li {
        font-size: 11px;
        color: var(--color-text-secondary);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .x-icon {
        color: var(--color-accent);
        font-weight: 700;
        font-size: 14px;
    }

    /* === FOOTER === */
    .footer-section {
        padding: 14px;
        border-top: 1px solid rgba(120, 119, 198, 0.2);
        background: rgba(3, 30, 66, 0.4);
        z-index: 10;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .footer-item {
        display: flex;
        gap: 6px;
        font-size: 10px;
        letter-spacing: 0.5px;
    }

    .footer-label {
        color: var(--color-primary-light);
        font-weight: 600;
    }

    .footer-item span:not(.footer-label) {
        color: var(--color-text-secondary);
    }

    .footer-divider {
        width: 1px;
        height: 14px;
        background: rgba(120, 119, 198, 0.3);
    }

    .threat-level {
        color: var(--color-accent);
        font-weight: 600;
    }

    /* === ANIMACIÓN DE SALIDA === */
    .fade-out {
        animation: fadeOut 1s forwards;
    }

    @keyframes fadeOut {
        0% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.5;
        }
        100% {
            opacity: 0;
            visibility: hidden;
            transform: scale(0.95);
        }
    }

    /* === RESPONSIVE === */
    @media (max-width: 1200px) {
        .content-wrapper {
            gap: 20px;
            padding: 30px;
        }
    }

    @media (max-width: 1024px) {
        .content-wrapper {
            grid-template-columns: 1fr;
            gap: 20px;
            padding: 24px;
        }

        .terminal-content {
            height: 200px;
        }

        #progress-counter {
            font-size: 24px;
        }

        .warning-title {
            font-size: 20px;
        }
    }

    @media (max-width: 768px) {
        .pantalla-carga {
            padding: 0;
        }

        .threat-header {
            padding: 16px;
        }

        .content-wrapper {
            grid-template-columns: 1fr;
            gap: 16px;
            padding: 16px;
        }

        .left-panel {
            display: none;
        }

        .warning-icon {
            width: 36px;
            height: 36px;
        }

        .warning-title {
            font-size: 18px;
        }

        .threat-status {
            font-size: 12px;
        }

        #progress-counter {
            font-size: 28px;
        }

        .stat-card {
            padding: 12px;
        }

        .stat-number {
            font-size: 16px;
        }
    }

    @media (max-width: 480px) {
        .content-wrapper {
            padding: 12px;
            gap: 12px;
        }

        .threat-header {
            padding: 12px;
        }

        .threat-status {
            font-size: 11px;
        }

        .warning-title {
            font-size: 16px;
        }

        .warning-description {
            font-size: 12px;
        }

        #progress-counter {
            font-size: 24px;
        }

        .footer-item {
            font-size: 9px;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
    }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
      const progressFill = document.getElementById('progress-bar-fill');
      const progressCounter = document.getElementById('progress-counter');
      const loadingScreen = document.getElementById('pantalla-ransomware');
      let progress = 0;

      if (!loadingScreen || !progressFill || !progressCounter) return;

      const updateProgress = () => {
          progressFill.style.width = `${progress}%`;
          progressCounter.textContent = `${progress}%`;
      };

      const interval = setInterval(() => {
          const increment = Math.floor(Math.random() * 8) + 2;
          progress += increment;

          if (progress >= 100) {
              progress = 100;
              updateProgress();
              clearInterval(interval);

              setTimeout(() => {
                  loadingScreen.classList.add('fade-out');

                  setTimeout(() => {
                      loadingScreen.remove();
                  }, 1000);

              }, 800);

          } else {
              updateProgress();
          }
      }, 180);
  });
</script>