---

<Layout title={`Portafolio - ${INFO_TAREA.titulo}`} description={INFO_TAREA.descripcion}>
<style>
  :global(header), :global(nav) { display: none !important; }
  html { scroll-behavior: smooth; }

  #roadmap-sidebar {
    width: 320px;
    flex-shrink: 0;
    position: sticky;
    top: 1.5rem;
    height: calc(100vh - 3rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #10b981 transparent;
    padding-right: 1rem;
  }

  .sbi {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    transition: all 0.3s ease;
    opacity: 0.6;
    text-decoration: none;
    font-size: 0.9rem;
    border-left: 3px solid transparent;
    cursor: pointer;
  }

  .sbi:hover {
    opacity: 0.85;
    background: rgba(16, 185, 129, 0.1);
    transform: translateX(4px);
  }

  .sbi.active {
    opacity: 1;
    background: rgba(16, 185, 129, 0.2);
    border-left-color: #10b981;
    box-shadow: inset 0 0 20px rgba(16, 185, 129, 0.1);
  }

  .sbi-label {
    font-weight: 500;
    color: #e2e8f0;
    transition: all 0.3s ease;
  }

  .sbi.active .sbi-label {
    color: #10b981;
    font-weight: 700;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }
    50% { box-shadow: 0 0 40px rgba(16, 185, 129, 0.6); }
  }

  .stat-card {
    animation: slideUp 0.6s ease forwards;
  }

  .stat-card:nth-child(1) { animation-delay: 0.1s; }
  .stat-card:nth-child(2) { animation-delay: 0.2s; }
  .stat-card:nth-child(3) { animation-delay: 0.3s; }
  .stat-card:nth-child(4) { animation-delay: 0.4s; }

  .clause-card {
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .clause-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 25px 50px rgba(16, 185, 129, 0.2);
  }

  .risk-bar {
    height: 8px;
    background: linear-gradient(90deg, #10b981 0%, #f59e0b 50%, #ef4444 100%);
    border-radius: 4px;
    overflow: hidden;
  }

  .risk-fill {
    height: 100%;
    background: linear-gradient(90deg, #ef4444 0%, #f59e0b 100%);
  }

  .criticidad-badge {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border-radius: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .criticidad-critico {
    background: rgba(239, 68, 68, 0.25);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.5);
  }

  .criticidad-extremo {
    background: rgba(249, 115, 22, 0.25);
    color: #fed7aa;
    border: 1px solid rgba(249, 115, 22, 0.5);
  }

  .criticidad-alto {
    background: rgba(59, 130, 246, 0.25);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.5);
  }

  .criticidad-medio {
    background: rgba(34, 197, 94, 0.25);
    color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.5);
  }

  .timeline {
    position: relative;
    padding-left: 2.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 1.5rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, #10b981 0%, transparent 100%);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -2.25rem;
    top: 0.5rem;
    width: 1rem;
    height: 1rem;
    background: #10b981;
    border: 4px solid #0c0f1a;
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
  }

  .gradient-text {
    background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .icon-svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hover-lift {
    transition: transform 0.3s ease;
  }

  .hover-lift:hover {
    transform: translateY(-2px);
  }

  .glow-border {
    box-shadow: inset 0 0 20px rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.3);
  }

  .header-hero {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(6, 182, 212, 0.05) 100%);
  }

  .metric-box {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(2, 8, 23, 0.8) 100%);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .policy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .feature-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    color: #86efac;
    font-weight: 600;
  }
</style>

<main class="min-h-screen bg-gradient-to-br from-slate-950 via-[#0c0f1a] to-slate-900">
  <div class="flex gap-8 items-start max-w-[1800px] mx-auto px-4 py-8 pb-32">
    
    <!-- SIDEBAR PREMIUM -->
    <aside id="roadmap-sidebar" class="hidden lg:flex flex-col">
      <div class="mb-8 sticky top-8">
        <div class="header-hero rounded-xl p-5 border border-emerald-500/40 backdrop-blur-sm">
          <p class="text-[11px] font-black uppercase tracking-[0.3em] text-emerald-300 flex items-center gap-2 mb-2">
            <span class="inline-block w-2.5 h-2.5 bg-emerald-400 rounded-full animate-pulse"></span>
            PROYECTO SGSI ACTIVO
          </p>
          <p class="text-xs text-slate-400">Auditoría Anthropic 2026</p>
          <p class="text-xs text-emerald-400/80 mt-2 font-bold">Certificación ISO 27001:2022</p>
          <p class="text-[10px] text-slate-500 mt-1">573 páginas | 20 políticas | 93 controles</p>
          
          <div class="mt-4 pt-4 border-t border-emerald-500/20">
            <p class="text-[10px] text-slate-500 uppercase font-bold mb-2">Progreso</p>
            <div class="w-full h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full w-[85%] bg-gradient-to-r from-emerald-500 via-cyan-500 to-emerald-500 rounded-full"></div>
            </div>
            <p class="text-[10px] text-emerald-400 mt-2 font-semibold">85% Implementado</p>
          </div>
        </div>

        <!-- Mini stats -->
        <div class="mt-6 grid grid-cols-2 gap-2">
          <div class="bg-slate-900/70 border border-slate-700 rounded-lg p-3 hover:bg-slate-900 transition">
            <p class="text-[9px] text-slate-500 uppercase font-bold">Riesgos Extremos</p>
            <p class="text-2xl font-black text-orange-400">6</p>
          </div>
          <div class="bg-slate-900/70 border border-slate-700 rounded-lg p-3 hover:bg-slate-900 transition">
            <p class="text-[9px] text-slate-500 uppercase font-bold">Políticas</p>
            <p class="text-2xl font-black text-emerald-400">20</p>
          </div>
          <div class="bg-slate-900/70 border border-slate-700 rounded-lg p-3 hover:bg-slate-900 transition">
            <p class="text-[9px] text-slate-500 uppercase font-bold">Cobertura MFA</p>
            <p class="text-2xl font-black text-blue-400">100%</p>
          </div>
          <div class="bg-slate-900/70 border border-slate-700 rounded-lg p-3 hover:bg-slate-900 transition">
            <p class="text-[9px] text-slate-500 uppercase font-bold">MTTD</p>
            <p class="text-2xl font-black text-cyan-400">8m</p>
          </div>
        </div>
      </div>

      <nav class="flex flex-col gap-1" id="toc-nav">
        {SECCIONES.map((sec) => (
          <a href={`#clausula-${sec.id}`} class="sbi" data-target={`clausula-${sec.id}`}>
            <span class="text-xs font-bold w-6 h-6 flex items-center justify-center rounded-md bg-slate-800 text-emerald-400">
              {sec.id}
            </span>
            <span class="sbi-label text-sm flex-1">{sec.label.split('.')[1]?.trim()}</span>
            <span class="text-slate-600 group-hover:text-emerald-500">→</span>
          </a>
        ))}
      </nav>

      <div class="mt-8 pt-6 border-t border-slate-800">
        <p class="text-xs text-slate-500 uppercase font-bold mb-3">Equipo</p>
        <div class="space-y-2 text-[11px]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
            <span class="text-slate-400">CISO • Seguridad</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
            <span class="text-slate-400">CTO • Infraestructura</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
            <span class="text-slate-400">1,100 Empleados</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="flex-1 min-w-0">
      
      <!-- MEGA HEADER -->
      <div class="mb-16">
        <div class="header-hero border border-emerald-500/30 rounded-3xl overflow-hidden">
          <div class="bg-gradient-to-br from-slate-900 to-black px-8 md:px-14 pt-20 pb-16">
            <div class="max-w-4xl">
              <div class="flex items-center gap-3 mb-6">
                <svg class="w-8 h-8 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span class="text-emerald-400 font-bold uppercase tracking-widest text-xs">ISO/IEC 27001:2022</span>
              </div>
              
              <h1 class="text-6xl md:text-7xl font-black text-white mb-6 tracking-tight leading-tight">
                Sistema de Gestión <span class="gradient-text">SGSI</span>
              </h1>
              
              <p class="text-lg text-slate-300 max-w-3xl mb-8 leading-relaxed">
                Implementación exhaustiva de seguridad de la información para Anthropic, protegiendo modelos Claude, infraestructura multi-cloud y datos de 10M+ usuarios globales mediante 93 controles alineados con estándares internacionales.
              </p>

              <div class="flex flex-wrap gap-3">
                <span class="px-4 py-2 bg-emerald-500/20 border border-emerald-500/50 rounded-full text-emerald-300 text-sm font-semibold">
                  ✓ 20 Políticas Funcionales
                </span>
                <span class="px-4 py-2 bg-cyan-500/20 border border-cyan-500/50 rounded-full text-cyan-300 text-sm font-semibold">
                  ✓ Ciclo PDCA Documentado
                </span>
                <span class="px-4 py-2 bg-orange-500/20 border border-orange-500/50 rounded-full text-orange-300 text-sm font-semibold">
                  ✓ Respuesta a Incidentes
                </span>
              </div>
            </div>
          </div>

          <!-- Mega Stats -->
