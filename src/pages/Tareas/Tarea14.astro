---
import Layout from "../../layouts/Layout.astro"
import SectionContainer from "../../components/SectionContainer.astro"
import TitleSection from "../../components/TitleSection.astro"
import CodeIcon from "../../components/Icons/Code.astro"
import Link from "../../components/Icons/Link.astro"

// ── Íconos
import Shield from "../../components/Icons/Shield.astro"
import Bolt from "../../components/Icons/Bolt.astro"
import Security from "../../components/Icons/Security.astro"
import Spy from "../../components/Icons/Spy.astro"
import Key from "../../components/Icons/Key.astro"
import Bug from "../../components/Icons/Virus.astro" 
import Settings from "../../components/Icons/Settings.astro"
import Wifi from "../../components/Icons/Wifi.astro" 

const INFO_TAREA = {
  titulo: "Actividad 14: Anatomía de un Ransomware — Desarrollo y Análisis",
  fecha: "05 de Abril, 2026",
  descripcion: "Diseño, desarrollo y análisis de la cadena de ejecución de un Ransomware en Python. Implementación de evasión de defensas, bomba lógica, cifrado intermitente, inhibición de copias de seguridad y movimiento lateral.",
  pdf: "", // Sin PDF para esta actividad
  imagen1: "/projects/Imagen1Tarea14.png",
  imagen2: "/projects/Imagen2Tarea14.png"
}
---

<Layout
  title={`Portafolio - ${INFO_TAREA.titulo}`}
  description={INFO_TAREA.descripcion}
>
  <style>
    :global(header) {
      display: none !important;
    }
  </style>

  <main class="px-4">
    <SectionContainer class="py-16 md:py-20">

      {/* --- ENCABEZADO --- */}
      <TitleSection>
        <CodeIcon class="size-8" />
        {INFO_TAREA.titulo}
      </TitleSection>

      <p class="text-sm text-gray-500 dark:text-gray-400 mb-8 -mt-4 border-b border-gray-200 dark:border-gray-800 pb-4">
        📅 Entregado el: {INFO_TAREA.fecha}
      </p>

      {/* Banner THREAT LEVEL */}
      <div class="mb-10 flex items-center gap-3 px-4 py-3 rounded-lg bg-red-950/60 border border-red-500/50">
        <Bug class="size-5 text-red-500 shrink-0 animate-pulse" />
        <p class="text-red-300 text-sm font-bold">
          [ALERTA DE SEGURIDAD] — Payload Criptográfico Activo. Extorsión e impacto destructivo en el sistema.
        </p>
        <span class="ml-auto text-xs font-mono text-red-500/80 hidden sm:block">THREAT: RANSOMWARE</span>
      </div>

      <div class="prose dark:prose-invert max-w-none text-gray-800 dark:text-gray-200 space-y-12">

        {/* ── CONCEPTO CLAVE ── */}
        <div>
          <p class="text-xs font-mono text-gray-500 mb-1">// ANÁLISIS ESTRUCTURAL DE MALWARE</p>
          <h3 class="text-xl font-semibold mb-3 text-red-500/90">Anatomía de un Ransomware</h3>
          <p>
            Un <strong>Ransomware</strong> es una pieza de software malicioso diseñada para denegar el acceso a un sistema informático o a los datos que contiene (secuestro digital), exigiendo el pago de un rescate (generalmente en criptomonedas) para su liberación. Su impacto ataca directamente el pilar de la <strong>Disponibilidad</strong> en la tríada CIA.
          </p>
          <p class="mt-3">
            El ransomware moderno rara vez es un simple script de cifrado; funciona como una infraestructura compleja. En esta actividad se desarrolló una prueba de concepto (PoC) en Python que abarca todas las fases de la <em>Cyber Kill Chain</em> de un ransomware avanzado: desde el engaño inicial y la evasión de entornos aislados (Sandbox), hasta el cifrado y la extorsión interactiva mediante interfaz gráfica.
          </p>
        </div>

        {/* ── MATRIZ DE FUNCIONES (KIL CHAIN) ── */}
        <div>
          <h3 class="text-xl font-semibold mb-4 text-blue-500/80 flex items-center gap-2">
            <Settings class="size-6 text-gray-400" />
            Vectores Ofensivos Implementados
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-red-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Spy class="size-5 text-red-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Evasión y Anti-Análisis</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Verifica si hay depuradores activos, audita los recursos de hardware (RAM/CPU) y escanea direcciones MAC para detectar hipervisores (VMware/VirtualBox). Incluye un ataque de tiempo para evadir Sandboxes.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-yellow-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Bolt class="size-5 text-yellow-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Inhibición de Recuperación</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Ejecuta comandos silenciosos (<code>vssadmin</code> y <code>wbadmin</code>) para purgar las <em>Shadow Copies</em> de Windows y los catálogos de copias de seguridad locales, asegurando que la víctima no pueda restaurar el sistema.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-purple-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Wifi class="size-5 text-purple-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Movimiento Lateral</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Escanea la subred usando paquetes ICMP, localiza hosts activos y utiliza el recurso compartido <code>Admin$</code> junto con <strong>PsExec</strong> para ejecutar la carga útil en otros equipos de la red.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-blue-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Key class="size-5 text-blue-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Cifrado Intermitente</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                En lugar de cifrar todo el archivo (lento), salta en bloques de 10MB y cifra solo 10KB. Esto maximiza la velocidad de destrucción e impide la recuperación del archivo original, alterando su extensión a <code>.osvaldo</code>.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-green-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Security class="size-5 text-green-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Bomba Lógica y Persistencia</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Se copia a sí mismo en <code>AppData</code> y crea una tarea programada. Permanece inactivo hasta que el reloj del sistema coincide con la fecha detonante (<em>Marker</em>).
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-orange-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Settings class="size-5 text-orange-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Extorsión (Pantalla de Bloqueo)</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Usa hilos concurrentes para cifrar en segundo plano mientras lanza una interfaz gráfica en pantalla completa con <code>tkinter</code> que oculta el cursor y despliega la nota de rescate en rojo.
              </p>
            </div>

          </div>
        </div>

        {/* ── CÓDIGO FUENTE DEL PAYLOAD COMPLETO ── */}
        <div>
          <h3 class="text-xl font-semibold mb-3 text-blue-500/80">Código Fuente: Prueba de Concepto (PoC)</h3>
          <p class="mb-4 text-sm text-gray-400">
            A continuación se presenta el código fuente completo del Ransomware desarrollado. Este script centraliza la lógica de ataque, desde el engaño inicial hasta la concurrencia multihilo para el cifrado masivo:
          </p>

          <div class="relative bg-[#0d1117] text-gray-300 rounded-lg shadow-xl overflow-hidden border border-gray-700">
            <div class="bg-[#161b22] px-4 py-2 flex items-center gap-2 border-b border-gray-700">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-xs text-gray-400 font-mono">python — osvaldo_ransomware_poc.py</span>
            </div>
            {/* Contenedor con Scroll para código largo */}
            <div class="p-4 overflow-y-auto max-h-[600px] overflow-x-auto custom-scrollbar">
              <pre class="font-mono text-xs leading-relaxed">
