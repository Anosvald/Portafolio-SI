        <span class="text-green-400">".bak"</span>, <span class="text-green-400">".bkp"</span>, <span class="text-green-400">".tmp"</span>, <span class="text-green-400">".tar.gz"</span>, <span class="text-green-400">".zip"</span>, <span class="text-green-400">".rar"</span>, <span class="text-green-400">".7z"</span>,
        <span class="text-green-400">".vmdk"</span>, <span class="text-green-400">".vhdx"</span>, <span class="text-green-400">".vdi"</span>,
